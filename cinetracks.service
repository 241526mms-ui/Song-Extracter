[Unit]
Description=CineTracks Movie Soundtrack & Song Exporter
After=network.target

[Service]
Type=simple
User=mohith
WorkingDirectory=/home/mohith/Projects/Music
ExecStart=/home/mohith/Projects/Music/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3
Environment="PATH=/home/mohith/Projects/Music/.venv/bin:/usr/bin"

[Install]
WantedBy=multi-user.target

